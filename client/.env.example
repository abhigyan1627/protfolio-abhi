# Copy to client/.env for local development. Only VITE_ variables reach the browser; never put secrets here.

# API base. Use /api for local development (Vite proxies it to the API).
# In production point this at the deployed API, for example https://ca-mohit-api.onrender.com/api
VITE_API_BASE_URL=/api

# Public address of the website, used for canonical links, Open Graph tags and the sitemap.
VITE_SITE_URL=http://localhost:5173
