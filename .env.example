# Copy to .env.local for local development, and set the same keys in the hosting dashboard for production.
# Only non-secret values belong here: any VITE_ variable is bundled into the public JavaScript.

# Optional. An HTTPS endpoint that receives enquiry-form submissions as JSON (a form-handling service or a
# serverless function you control). Leave empty to use the WhatsApp handoff instead. The site never claims a
# submission was delivered unless this endpoint answers with a 2xx status.
VITE_ENQUIRY_FORM_ENDPOINT=
