  "version": "1.0.0",
  "description": "Premium website template for a Chartered Accountant firm with WhatsApp-first enquiries.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
