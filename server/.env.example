# Copy to server/.env for local development. Never commit the real file.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (local example uses the database created in README).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ca_mohit_agrawal_dev?schema=public

# Long random string used to HMAC session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-64-character-random-string-generated-locally-xx

# Origins allowed to call this API directly (comma-separated, no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Admin session lifetime in hours (1-72).
SESSION_TTL_HOURS=8

# Cookie SameSite policy: lax (same-site hosting, default in development),
# none (frontend and API on different domains, default in production; requires HTTPS),
# or strict. Leave blank to use the default for NODE_ENV.
COOKIE_SAME_SITE=

# Number of reverse proxies in front of this server (Render = 1).
TRUST_PROXY_HOPS=1

# Used only by the one-time admin creation command (npm run admin:create).
# Remove the password from the environment after the account is created.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
# OWNER (full access), EDITOR (content) or VIEWER (read-only). Defaults to OWNER.
ADMIN_ROLE=OWNER

# Initial business details used when the site settings row is first created.
# The owner can change every value later in the admin panel.
BUSINESS_NAME=CA Mohit Agrawal
BUSINESS_PHONE=+91 62990 33454
BUSINESS_WHATSAPP_NUMBER=916299033454
BUSINESS_EMAIL=
BUSINESS_ADDRESS=Muskan, Kedia Lane, Town Thana, Gopalganj, Bihar 841428, India
BUSINESS_PLUS_CODE=FC7V+QC, Gopalganj
